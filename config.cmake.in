# make sure the slashes are windows style ("\\") if you want NS_GENERATE_VS_LAUNCH_CONFIG to work
if(NOT DEFINED NS_BINARY_DIR)
    set(NS_BINARY_DIR "@NS_BINARY_DIR_DEFAULT@")
endif()

if(NOT DEFINED NS_PUBLISH_LAUNCHER)
    set(NS_PUBLISH_LAUNCHER @NS_PUBLISH_LAUNCHER_DEFAULT@)
endif()

if(NOT DEFINED NS_LAUNCHER_RUNTIME_IDENTIFIER)
    set(NS_LAUNCHER_RUNTIME_IDENTIFIER "@NS_LAUNCHER_RUNTIME_IDENTIFIER_DEFAULT@")
endif()

if(NOT DEFINED NS_BUILD_LEGACY_CPP_LAUNCHER)
    set(NS_BUILD_LEGACY_CPP_LAUNCHER @NS_BUILD_LEGACY_CPP_LAUNCHER_DEFAULT@)
endif()

if(NOT DEFINED NS_GENERATE_VS_LAUNCH_CONFIG)
    set(NS_GENERATE_VS_LAUNCH_CONFIG @NS_GENERATE_VS_LAUNCH_CONFIG_DEFAULT@)
endif()
